<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PARMEL - MYPAL</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;700&family=M+PLUS+Rounded+1c:wght@500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #0b0d0e;
      --card-bg: linear-gradient(135deg, #24292e 0%, #16181b 100%);
      --card-border: rgba(255, 255, 255, 0.08);
      --card-shadow: 0 12px 32px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.15);
      --avatar-bg: linear-gradient(135deg, rgba(255,255,255,0.3), rgba(255,255,255,0.05));
      --text-main: #f5f6f8;
      --text-sub: #9aa0a6;
      --gold: #e5c07b;
      --radius-card: 18px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
    
    html, body {
      width: 100%;
      height: 100%;
      background: var(--bg-main);
      color: var(--text-main);
      font-family: 'Noto Sans JP', sans-serif;
      overflow-x: hidden;
      overflow-y: auto;
    }

    body.mypal-mode {
      overflow: hidden;
      touch-action: none;
    }

    body {
      display: flex;
      justify-content: center;
      padding: 12px 12px 0px;
    }

    .app-viewport {
      width: 100%;
      max-width: 414px;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .page { display: none; flex-direction: column; gap: 16px; width: 100%; }
    .page.active { display: flex; }

    #page-mypal {
      height: calc(100vh - 80px);
      justify-content: flex-start;
    }

    /* 名刺カード（3Dフリップ用コンテナ） */
    .palcard-container {
      perspective: 1000px;
      width: 100%;
      aspect-ratio: 1.55 / 1;
      flex-shrink: 0;
      cursor: pointer;
    }

    .palcard-flipper {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
      transform-style: preserve-3d;
      pointer-events: none;
    }

    .palcard-container.flipped .palcard-flipper {
      transform: rotateY(180deg);
    }

    /* 名刺カードデザイン共通 */
    .palcard {
      position: absolute;
      inset: 0;
      background: var(--card-bg);
      background-size: cover;
      background-position: center;
      border-radius: var(--radius-card);
      padding: 12px 14px 44px;
      box-shadow: var(--card-shadow);
      border: 1px solid var(--card-border);
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow: hidden;
      transition: background 0.3s ease;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      pointer-events: auto;
    }

    .palcard-back {
      transform: rotateY(180deg);
      justify-content: space-between;
    }

    .palcard-brand { font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.35em; color: var(--text-sub); font-weight: 600; text-align: center; margin-bottom: 2px; }
    .palcard-body { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; flex: 1; }
    
    .profile-info { 
      flex: 1; 
      display: flex; 
      flex-direction: column; 
      min-width: 0; 
      justify-content: flex-start; 
      margin-top: 10px;
    }
    
    .user-title-display {
      font-size: 0.72rem;
      color: var(--gold);
      font-weight: 500;
      margin-top: 4px; 
      margin-bottom: 3px;
      letter-spacing: 0.05em;
      min-height: 0.9rem;
    }

    .pet-name { 
      font-family: 'Cinzel', serif; 
      font-size: 2.15rem; 
      line-height: 1.0; 
      margin-top: 2px;   
      margin-bottom: 6px;  
      font-weight: 700; 
      color: #fff; 
      letter-spacing: 0.02em; 
    }
    
    .profile-fields { display: flex; flex-direction: column; gap: 1px; }
    
    .field-row {
      position: relative;
      display: flex;
      align-items: center;
      padding-bottom: 2px;
      margin-bottom: 2px;
      padding-right: 8px;
    }
    .field-row::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 95%;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .field-label { font-size: 0.52rem; color: var(--text-sub); width: 60px; flex-shrink: 0; }
    .field-value { color: var(--text-main); font-size: 0.6rem; font-weight: 500; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .right-avatar-container { 
      position: relative; 
      width: 168px; 
      flex-shrink: 0; 
      display: flex; 
      align-items: flex-start; 
      justify-content: center; 
      margin-top: 18px; 
    }
    .avatar-wrapper { width: 164px; height: 164px; border-radius: 50%; padding: 3px; background: var(--avatar-bg); display: block; transition: all 0.3s ease; }
    
    .avatar-inner { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; background: #1a1d20; }
    .avatar-inner img { width: 100%; height: 100%; object-fit: cover; }

    .palcard-footer { position: absolute; left: 14px; right: 14px; bottom: 8px; display: flex; align-items: center; justify-content: space-between; z-index: 5; }
    .footer-left-group { display: flex; gap: 10px; }
    
    .icon-btn {
      height: 26px; 
      min-width: 52px; 
      padding: 0 8px; 
      background: rgba(255, 255, 255, 0.12); 
      border: 1px solid rgba(255, 255, 255, 0.22); 
      border-radius: 8px; 
      color: var(--text-main); 
      font-size: 0.52rem; 
      cursor: pointer; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      font-weight: 500; 
      text-decoration: none;
    }

    .sns-links-container { display: flex; gap: 6px; align-items: center; }
    .sns-btn {
      display: none; height: 26px; width: 26px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 8px; color: var(--text-main); font-size: 0.7rem; align-items: center; justify-content: center; text-decoration: none;
    }
    .sns-btn.active { display: flex; }

    /* 背面カード専用のデザインレイアウト */
    .back-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      flex: 1;
      gap: 14px;
      text-align: center;
      padding: 10px 0 20px;
    }
    .back-owner-title { font-size: 0.55rem; letter-spacing: 0.2em; color: var(--text-sub); }
    .back-owner-name { font-family: 'Cinzel', serif; font-size: 1.4rem; font-weight: 700; color: var(--gold); letter-spacing: 0.05em; }
    .back-sns-list { display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 220px; }
    .back-sns-item {
      display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 12px;
      background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 10px; color: var(--text-main); font-size: 0.7rem; text-decoration: none; transition: background 0.2s;
    }
    .back-sns-item.inactive { opacity: 0.4; pointer-events: none; }
    .back-flip-tip { font-size: 0.48rem; color: var(--text-sub); letter-spacing: 0.1em; opacity: 0.7; }

    /* プレゼン拡大時のスタイル */
    .card-present-overlay {
      display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.98);
      backdrop-filter: blur(20px); z-index: 20000; justify-content: center; align-items: center; cursor: pointer;
    }
    .card-present-overlay.active { display: flex; }
    
    .card-present-wrapper {
      width: 100vh;
      height: 100vw;
      display: flex;
      justify-content: center;
      align-items: center;
      transition: transform 0.4s cubic-bezier(0.25, 1.3, 0.5, 1);
      transform: rotate(90deg) scale(0.9); opacity: 0;
    }
    .card-present-overlay.active .card-present-wrapper { 
      transform: rotate(90deg) scale(1); 
      opacity: 1; 
    }

    .card-present-tip { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); color: var(--text-sub); font-size: 0.65rem; letter-spacing: 0.1em; pointer-events: none; z-index: 20001; }

    .palcard.is-presented {
      position: relative !important;
      inset: auto !important;
      width: 82vh !important;
      height: auto !important;
      max-width: none !important;
      max-height: none !important;
      aspect-ratio: 1.55 / 1 !important;
      padding: 18px 24px !important;
      border-radius: 24px !important;
      box-shadow: 0 30px 90px rgba(0, 0, 0, 0.95), inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
    }
    .palcard.is-presented .profile-fields,
    .palcard.is-presented .palcard-footer { display: none !important; }
    
    .palcard.is-presented .palcard-brand { font-size: 0.75rem !important; letter-spacing: 0.35em !important; display: block !important; margin-bottom: 2px !important; margin-top: 0 !important; }
    
    .palcard.is-presented .palcard-body { display: flex !important; flex-direction: row !important; align-items: flex-start !important; justify-content: space-between !important; height: auto !important; gap: 12px !important; margin-top: 10px !important; }
    
    .palcard.is-presented .user-title-display { display: none !important; }
    
    .palcard.is-presented .profile-info { 
      flex: 1 !important; 
      display: flex !important; 
      flex-direction: column !important; 
      align-items: center !important; 
      justify-content: flex-start !important; 
      height: auto !important; 
      margin-top: 36px !important; 
      padding: 0 !important; 
    }
    
    .palcard.is-presented .qr-frame-box {
      width: 36vh !important;
      height: 36vh !important;
      max-width: 235px !important;
      max-height: 235px !important;
      background: #ffffff !important;
      border: 4px solid var(--gold) !important;
      border-radius: 16px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 10px !important;
      box-shadow: 0 10px 30px rgba(0,0,0,0.7) !important;
    }
    .palcard.is-presented .qr-frame-box img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
    }

    .palcard.is-presented .right-avatar-container { 
      flex: 1 !important; 
      width: auto !important; 
      height: auto !important; 
      margin-top: 26px !important; 
      display: flex !important; 
      flex-direction: column !important; 
      align-items: center !important; 
      justify-content: flex-start !important; 
      padding: 0 !important; 
      gap: 12px !important; 
    }
    
    .palcard.is-presented .right-avatar-container .avatar-wrapper { 
      width: 36vh !important; 
      height: 36vh !important; 
      max-width: 235px !important; 
      max-height: 235px !important; 
      border-radius: 50% !important; 
      margin: 0 !important; 
      flex-shrink: 0 !important; 
      display: block !important; 
    }
    .palcard.is-presented .right-avatar-container .avatar-inner { border-radius: 50% !important; }
    
    .palcard.is-presented .present-pet-name { display: block !important; font-family: 'Cinzel', serif; font-size: 1.8rem !important; margin: 0 !important; text-align: center !important; line-height: 1.0 !important; color: #fff; font-weight: 700; letter-spacing: 0.05em; }
    .palcard.is-presented .pet-name { display: none !important; }

    /* 9マス Grid */
    .grid-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: 100%; }
    .grid-item { background: #15181b; border-radius: 8px; display: flex; flex-direction: column; aspect-ratio: 1 / 1.25; position: relative; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.04); }
    .grid-label { font-family: 'Cinzel', 'Noto Sans JP', serif; font-size: 0.58rem; letter-spacing: 0.1em; text-align: center; padding: 4px 2px; background: rgba(0, 0, 0, 0.4); color: var(--text-sub); display: flex; align-items: center; justify-content: center; z-index: 2; }
    
    .grid-label-input {
      background: transparent; border: none; border-bottom: 1px dashed rgba(229, 192, 123, 0.5);
      color: var(--gold); font-family: inherit; font-size: 0.58rem; text-align: center; width: 90%; outline: none; letter-spacing: 0.05em; font-weight: bold;
    }
    .grid-label-input::placeholder { color: rgba(229, 192, 123, 0.4); }
    .grid-label-input:focus { border-bottom-color: var(--gold); background: rgba(0, 0, 0, 0.3); }

    .grid-image-box { flex: 1; width: 100%; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; }
    .grid-image-box img { width: 100%; height: 100%; object-fit: cover; }
    
    /* 右下「NOSE＋PALMEL」のマス専用の演出レイアウト */
    .grid-item.palmel-item .grid-image-box {
      position: relative;
    }
    
    /* アップロードされた画像にしっかりとした暗いオーバーレイをかける */
    .grid-item.palmel-item .grid-image-box img.has-image {
      filter: brightness(0.45);
    }

    /* 光るPALMELロゴのスタイル（Specialを削除） */
    .palmel-overlay-logo {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 5;
      pointer-events: none;
      font-family: 'Cinzel', serif;
      letter-spacing: 0.15em;
      color: rgba(255, 255, 255, 0.95);
      text-shadow: 0 0 10px rgba(229, 192, 123, 0.6), 0 0 20px rgba(229, 192, 123, 0.3);
      font-size: 0.8rem;
      font-weight: 700;
      animation: palmelGlow 3s ease-in-out infinite alternate;
      text-align: center;
      padding: 0 2px;
    }

    @keyframes palmelGlow {
      0% {
        text-shadow: 0 0 8px rgba(229, 192, 123, 0.4), 0 0 15px rgba(229, 192, 123, 0.2);
        opacity: 0.85;
      }
      100% {
        text-shadow: 0 0 14px rgba(229, 192, 123, 0.8), 0 0 25px rgba(229, 192, 123, 0.5);
        opacity: 1;
      }
    }

    input[type="file"] { display: none; }

    .custom-file-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      padding: 10px 14px;
      color: var(--text-main);
      font-size: 0.75rem;
      cursor: pointer;
      width: 100%;
      text-align: center;
      transition: background 0.2s, border-color 0.2s;
    }
    .custom-file-btn:active {
      background: rgba(229, 192, 123, 0.15);
      border-color: var(--gold);
    }

    /* モーダル・ドロワー関連のスタイル */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(5, 6, 7, 0.95); backdrop-filter: blur(12px); z-index: 8500; justify-content: center; align-items: center; }
    .modal-overlay.active { display: flex; }
    .modal-content { background: #16181b; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius-card); width: 90%; max-width: 380px; padding: 20px; max-height: 85vh; overflow-y: auto; }

    .form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .form-label { font-size: 0.7rem; color: var(--text-sub); }
    .form-input { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 8px; padding: 10px; color: #fff; font-size: 0.8rem; outline: none; }
    .form-input:focus { border-color: var(--gold); }

    .drawer-overlay {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px); z-index: 25000; opacity: 0; pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .drawer-overlay.active { opacity: 1; pointer-events: auto; }

    .side-drawer {
      position: fixed; top: 0; left: 0; width: 280px; height: 100%;
      background: #14171a; border-right: 1px solid rgba(255, 255, 255, 0.1);
      z-index: 26000; transform: translateX(-100%);
      display: flex; flex-direction: column; justify-content: space-between; padding: 20px 16px;
      box-shadow: 10px 0 30px rgba(0,0,0,0.8);
      will-change: transform;
    }
    .side-drawer.animated { transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1); }
    .side-drawer.open { transform: translateX(0); }

    .drawer-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px; }
    .drawer-title { font-family: 'Cinzel', serif; color: var(--gold); font-size: 0.9rem; font-weight: bold; letter-spacing: 0.1em; }
    .drawer-close-btn { background: none; border: none; color: var(--text-sub); font-size: 1.2rem; cursor: pointer; }

    .drawer-menu-list { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
    .drawer-item {
      display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; color: var(--text-main); font-size: 0.8rem;
      cursor: pointer; text-align: left; transition: background 0.2s ease; text-decoration: none; width: 100%;
    }
    .drawer-item:active { background: rgba(229,192,123,0.15); border-color: var(--gold); }

    /* ボトムナビゲーション */
    .bottom-nav {
      position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 100%; max-width: 414px; height: 60px;
      background: rgba(15, 17, 20, 0.95); backdrop-filter: blur(16px);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      display: flex; justify-content: space-around; align-items: center; z-index: 99999;
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .nav-btn { background: none; border: none; color: var(--text-sub); display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 0.62rem; cursor: pointer; width: 25%; text-decoration: none; }
    .nav-btn.active { color: var(--gold); }
  </style>
</head>
<body class="mypal-mode">

  <!-- サイドドロワーメニュー -->
  <div id="drawer-overlay" class="drawer-overlay" onclick="closeDrawer()"></div>
  
  <aside id="side-drawer" class="side-drawer">
    <div>
      <div class="drawer-header">
        <span class="drawer-title">SETTINGS</span>
        <button class="drawer-close-btn" onclick="closeDrawer()">✕</button>
      </div>
      <div class="drawer-menu-list">
        <button class="drawer-item" onclick="toggleModal('palcard-edit-modal', true); closeDrawer();">PALCARD編集</button>
        <button class="drawer-item" onclick="toggleModal('account-modal', true); closeDrawer();">アカウント・プロフ設定</button>
        <a href="customize.html" class="drawer-item">デザイン着せ替え</a>
      </div>
    </div>
    <button class="drawer-item" style="color: #ff6b6b; border-color: rgba(255,107,107,0.3); background: rgba(255,107,107,0.05);" onclick="alert('ログアウトしました'); closeDrawer();">ログアウト</button>
  </aside>

  <div class="app-viewport">
    
    <!-- MYPAL ホーム画面 -->
    <div id="page-mypal" class="page active">

      <!-- 名刺カード（3Dフリップ対応） -->
      <div class="palcard-container" id="palcard-container" onclick="toggleCardFlip(event)">
        <div class="palcard-flipper">
          
          <!-- 表面 -->
          <div class="palcard" id="main-palcard">
            <div class="palcard-brand">PALCARD</div>
            <div class="palcard-body">
              <div class="profile-info">
                <div id="in-user-title" class="user-title-display">FIRST PAL</div>
                <div id="in-name" class="pet-name">MEL</div>
                <div class="profile-fields">
                  <div class="field-row"><span class="field-label">生年月日</span><div id="in-birth" class="field-value">2026.02.10</div></div>
                  <div class="field-row"><span class="field-label">nickname</span><div id="in-nickname" class="field-value">メルちゃん</div></div>
                  <div class="field-row"><span class="field-label">message</span><div id="in-owner" class="field-value">こんにちは</div></div>
                  <div class="field-row"><span class="field-label">pallike</span><div id="in-pallike" class="field-value" style="color:var(--gold); font-weight:bold;">♡ 0</div></div>
                </div>
              </div>
              
              <div class="right-avatar-container">
                <div class="avatar-wrapper" id="main-avatar-wrapper">
                  <div class="avatar-inner"><img id="avatar-img" src="https://images.dog.ceo/breeds/retriever-golden/n02099601_3004.jpg"></div>
                </div>
                <div class="present-pet-name" id="present-pet-name-display" style="display:none;">MEL</div>
              </div>
            </div>

            <div class="palcard-footer" id="main-palcard-footer">
              <div class="footer-left-group">
                <button class="icon-btn" onclick="event.stopPropagation(); presentCard();"><span>PALINK</span></button>
                <label class="icon-btn" onclick="event.stopPropagation()">
                  <span>GET</span>
                  <input type="file" accept="image/*" capture="environment" onchange="handleGetCamera(this)">
                </label>
              </div>
              <div class="sns-links-container">
                <a id="btn-sns-instagram" href="#" target="_blank" class="sns-btn" title="Instagram" onclick="event.stopPropagation()">📸</a>
                <a id="btn-sns-x" href="#" target="_blank" class="sns-btn" title="X (Twitter)" onclick="event.stopPropagation()">𝕏</a>
              </div>
            </div>
          </div>

          <!-- 背面 -->
          <div class="palcard palcard-back" id="back-palcard">
            <div class="palcard-brand">PALCARD</div>
            <div class="back-content">
              <div>
                <div class="back-owner-title">OWNER NAME</div>
                <div class="back-owner-name" id="back-owner-display">Rui</div>
              </div>
              <div class="back-sns-list">
                <a id="back-btn-instagram" href="#" target="_blank" class="back-sns-item inactive" onclick="event.stopPropagation()">📸Instagramを開く</a>
                <a id="back-btn-x" href="#" target="_blank" class="back-sns-item inactive" onclick="event.stopPropagation()">𝕏 (Twitter) を開く</a>
              </div>
            </div>
            <div style="text-align: center;">
              <span class="back-flip-tip">もう一度タップして表面に戻る</span>
            </div>
          </div>

        </div>
      </div>

      <!-- 9マス Grid -->
      <div class="grid-container">
        <script>
          const gridLabels = ['MONTHLY', 'CHARMPOINT', 'FREE', 'FOOD', 'MAIN', 'SLEEPING', 'TOYS', 'FUNNYSHOT', 'NOSE＋PALMEL'];
