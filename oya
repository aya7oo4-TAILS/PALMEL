              <div class="palmel-overlay-logo">
                PALMEL
              </div>
            ` : '';

            document.write(`
              <div class="grid-item${extraClass}">
                <div class="grid-label">${labelHtml}</div>
                <label class="grid-image-box">
                  <img id="g${i}">
                  ${innerExtra}
                  <input type="file" accept="image/*" onchange="previewGrid(this, 'g${i}', ${isPalmel})">
                </label>
              </div>`);
          });
        </script>
      </div>

    </div>

  </div>

  <!-- PALCARD編集モーダル -->
  <div id="palcard-edit-modal" class="modal-overlay">
    <div class="modal-content">
      <h3 style="font-family:'Cinzel'; border-bottom:1px solid #333; padding-bottom:6px; color:var(--gold);">PALCARD EDIT</h3>
      <div style="margin-top:14px;">
        <div class="form-group">
          <label class="form-label">アイコン画像 (ペットの写真)</label>
          <label class="custom-file-btn">
            写真を選ぶ
            <input type="file" id="edit-avatar-file" accept="image/*">
          </label>
        </div>
        <div class="form-group">
          <label class="form-label">ペットの名前 (例: MEL)</label>
          <input type="text" id="edit-name" class="form-input" placeholder="名前を入力">
        </div>
        <div class="form-group">
          <label class="form-label">生年月日 (例: 2026.02.10)</label>
          <input type="text" id="edit-birth" class="form-input" placeholder="生年月日を入力">
        </div>
        <div class="form-group">
          <label class="form-label">nickname (例: メルちゃん)</label>
          <input type="text" id="edit-nickname" class="form-input" placeholder="ニックネームを入力">
        </div>
        <div class="form-group">
          <label class="form-label">message (例: こんにちは)</label>
          <input type="text" id="edit-owner" class="form-input" placeholder="メッセージを入力">
        </div>
        <div class="form-group">
          <label class="form-label">オーナーネーム (例: Rui)</label>
          <input type="text" id="edit-ownername" class="form-input" placeholder="オーナー名を入力">
        </div>
      </div>
      <button style="margin-top:16px; width:100%; padding:10px; background:var(--gold); border:none; border-radius:10px; color:#000; font-weight:bold; cursor:pointer;" onclick="savePalcardEdit()">保存する</button>
    </div>
  </div>

  <!-- アカウント設定モーダル -->
  <div id="account-modal" class="modal-overlay">
    <div class="modal-content">
      <h3 style="font-family:'Cinzel'; border-bottom:1px solid #333; padding-bottom:6px; color:var(--gold);">ACCOUNT & PROFILE</h3>
      <div style="margin-top:14px;">
        <div class="form-group">
          <label class="form-label">Instagram ID (例: username)</label>
          <input type="text" id="acc-instagram" class="form-input" placeholder="ユーザー名を入力">
        </div>
        <div class="form-group">
          <label class="form-label">X (Twitter) ID (例: username)</label>
          <input type="text" id="acc-x" class="form-input" placeholder="ユーザー名を入力">
        </div>
      </div>
      <button style="margin-top:16px; width:100%; padding:10px; background:var(--gold); border:none; border-radius:10px; color:#000; font-weight:bold; cursor:pointer;" onclick="saveAccountSettings()">保存する</button>
    </div>
  </div>

  <!-- PALINK拡大表示用モーダル -->
  <div id="card-present-modal" class="card-present-overlay" onclick="closePresentCard()">
    <div class="card-present-wrapper" id="present-card-container"></div>
    <div class="card-present-tip">タップして閉じる</div>
  </div>

  <!-- ボトムナビゲーション -->
  <nav class="bottom-nav">
    <a href="index.html" class="nav-btn active" id="btn-mypal">MYPAL</a>
    <a href="album.html" class="nav-btn" id="btn-album">ALBUM</a>
    <a href="palrium.html" class="nav-btn" id="btn-exchange">PALRIUM</a>
    <a href="pals.html" class="nav-btn" id="btn-feed">PALS</a>
  </nav>

  <script>
    function toggleCardFlip(event) {
      if (['INPUT', 'BUTTON', 'A'].includes(event.target.tagName)) return;
      const container = document.getElementById('palcard-container');
      const footer = document.getElementById('main-palcard-footer');
      container.classList.toggle('flipped');
      
      if (container.classList.contains('flipped')) {
        footer.style.display = 'none';
      } else {
        footer.style.display = 'flex';
      }
    }

    function syncOwnerName(val) {
      const displayEl = document.getElementById('back-owner-display');
      if (displayEl) {
        displayEl.innerText = val ? val : 'OWNER';
      }
    }

    function syncCardName(val) {
      const displayEl = document.getElementById('present-pet-name-display');
      if (displayEl) {
        displayEl.innerText = val;
      }
    }

    const drawer = document.getElementById('side-drawer');
    const drawerOverlay = document.getElementById('drawer-overlay');
    const DRAWER_WIDTH = 280;
    let startX = 0, startY = 0, isTracking = false, isOpen = false;

    function openDrawer() {
      isOpen = true;
      drawer.classList.add('animated');
      drawer.style.transform = `translateX(0px)`;
      drawerOverlay.classList.add('active');
    }

    function closeDrawer() {
      isOpen = false;
      drawer.classList.add('animated');
      drawer.style.transform = `translateX(-100%)`;
      drawerOverlay.classList.remove('active');
    }

    window.addEventListener('touchstart', (e) => {
      if (['INPUT', 'BUTTON', 'LABEL', 'TEXTAREA', 'A'].includes(e.target.tagName)) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isTracking = true;
      drawer.classList.remove('animated');
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isTracking) return;
      const touchX = e.touches[0].clientX;
      const touchY = e.touches[0].clientY;
      const diffX = touchX - startX;
      const diffY = Math.abs(touchY - startY);

      if (diffY > Math.abs(diffX) && diffY > 10) { isTracking = false; return; }

      if (!isOpen) {
        if (diffX > 0) {
          let translateX = -DRAWER_WIDTH + diffX;
          if (translateX > 0) translateX = 0;
          drawer.style.transform = `translateX(${translateX}px)`;
          drawerOverlay.style.opacity = Math.min(diffX / DRAWER_WIDTH, 1);
          drawerOverlay.style.pointerEvents = 'auto';
        }
      } else {
        if (diffX < 0) {
          let translateX = diffX;
          if (translateX < -DRAWER_WIDTH) translateX = -DRAWER_WIDTH;
          drawer.style.transform = `translateX(${translateX}px)`;
          drawerOverlay.style.opacity = Math.max(1 + (diffX / DRAWER_WIDTH), 0);
        }
      }
    }, { passive: true });

    window.addEventListener('touchend', (e) => {
      if (!isTracking) return;
      isTracking = false;
      const endX = e.changedTouches[0].clientX;
      const diffX = endX - startX;

      drawerOverlay.style.opacity = '';
      drawerOverlay.style.pointerEvents = '';

      if (!isOpen) {
        if (diffX > 50) openDrawer(); else closeDrawer();
      } else {
        if (diffX < -50) closeDrawer(); else openDrawer();
      }
    }, { passive: true });

    function toggleModal(id, show) {
      const el = document.getElementById(id);
      if (show) {
        if(id === 'palcard-edit-modal') {
          document.getElementById('edit-name').value = document.getElementById('in-name').innerText;
          document.getElementById('edit-birth').value = document.getElementById('in-birth').innerText;
          document.getElementById('edit-nickname').value = document.getElementById('in-nickname').innerText;
          document.getElementById('edit-owner').value = document.getElementById('in-owner').innerText;
          document.getElementById('edit-ownername').value = document.getElementById('back-owner-display').innerText;
          document.getElementById('edit-avatar-file').value = '';
        }
        el.style.display = 'flex'; 
        requestAnimationFrame(() => el.classList.add('active'));
      } else { 
        el.classList.remove('active'); 
        setTimeout(() => { if (!el.classList.contains('active')) el.style.display = 'none'; }, 200); 
      }
    }

    function savePalcardEdit() {
      const nameVal = document.getElementById('edit-name').value;
      const birthVal = document.getElementById('edit-birth').value;
      const nicknameVal = document.getElementById('edit-nickname').value;
      const ownerVal = document.getElementById('edit-owner').value;
      const ownernameVal = document.getElementById('edit-ownername').value;
      const avatarInput = document.getElementById('edit-avatar-file');

      document.getElementById('in-name').innerText = nameVal;
      document.getElementById('in-birth').innerText = birthVal;
      document.getElementById('in-nickname').innerText = nicknameVal;
      document.getElementById('in-owner').innerText = ownerVal;

      syncCardName(nameVal);
      syncOwnerName(ownernameVal);

      if (avatarInput.files && avatarInput.files[0]) {
        const r = new FileReader();
        r.onload = e => {
          document.getElementById('avatar-img').src = e.target.result;
          const cloneAvatar = document.querySelector('#present-card-container #avatar-img');
          if(cloneAvatar) cloneAvatar.src = e.target.result;
        };
        r.readAsDataURL(avatarInput.files[0]);
      }

      toggleModal('palcard-edit-modal', false);
      alert('PALCARDの情報を更新しました！');
    }

    function saveAccountSettings() {
      const instaId = document.getElementById('acc-instagram').value.trim();
      const xId = document.getElementById('acc-x').value.trim();
      const btnInsta = document.getElementById('btn-sns-instagram');
      const btnX = document.getElementById('btn-sns-x');
      const backBtnInsta = document.getElementById('back-btn-instagram');
      const backBtnX = document.getElementById('back-btn-x');

      if (instaId) {
        const url = `https://instagram.com/${instaId.replace(/^@/, '')}`;
        btnInsta.href = url; btnInsta.classList.add('active');
        backBtnInsta.href = url; backBtnInsta.classList.remove('inactive');
      } else {
        btnInsta.classList.remove('active'); backBtnInsta.classList.add('inactive');
      }

      if (xId) {
        const url = `https://x.com/${xId.replace(/^@/, '')}`;
        btnX.href = url; btnX.classList.add('active');
        backBtnX.href = url; backBtnX.classList.remove('inactive');
      } else {
        btnX.classList.remove('active'); backBtnX.classList.add('inactive');
      }

      toggleModal('account-modal', false);
      alert('アカウント情報を更新しました！');
    }

    function previewGrid(input, imgId, isPalmel) {
      if (input.files && input.files[0]) {
        const r = new FileReader();
        r.onload = e => {
          const img = document.getElementById(imgId);
          img.src = e.target.result;
          img.style.display = 'block';
          if (isPalmel) {
            img.classList.add('has-image');
          }
        };
        r.readAsDataURL(input.files[0]);
      }
    }

    function handleGetCamera(input) {
      (input.files && input.files[0]) && alert('カード/写真を読み込みました！');
    }

    function presentCard() {
      const cardSrc = document.getElementById('main-palcard');
      const clone = cardSrc.cloneNode(true);
      clone.removeAttribute('id');
      clone.querySelectorAll('input[type="file"]').forEach(input => input.remove());
      clone.classList.add('is-presented');

      const currentNameValue = document.getElementById('in-name').innerText;
      clone.querySelectorAll('.present-pet-name').forEach(el => {
        el.innerText = currentNameValue;
        el.style.display = 'block';
      });

      const cloneAvatar = clone.querySelector('#avatar-img');
      const mainAvatar = document.getElementById('avatar-img');
      if(cloneAvatar && mainAvatar) cloneAvatar.src = mainAvatar.src;

      const profileInfoEl = clone.querySelector('.profile-info');
      if (profileInfoEl) {
        profileInfoEl.innerHTML = `
          <div class="qr-frame-box">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=https://parmel.example.com/palcard" alt="PALCARD QR Code">
          </div>
        `;
      }

      const container = document.getElementById('present-card-container');
      container.innerHTML = '';
      container.appendChild(clone);

      const bottomNav = document.querySelector('.bottom-nav');
      if (bottomNav) {
        bottomNav.style.opacity = '0';
        bottomNav.style.pointerEvents = 'none';
      }

      document.getElementById('card-present-modal').classList.add('active');
    }

    function closePresentCard() {
      document.getElementById('card-present-modal').classList.remove('active');

      const bottomNav = document.querySelector('.bottom-nav');
      if (bottomNav) {
        bottomNav.style.opacity = '1';
        bottomNav.style.pointerEvents = 'auto';
      }
    }
  </script>
