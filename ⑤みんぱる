  </div>

  <div class="app-viewport">
    <div id="timeline-container" style="display: flex; flex-direction: column; gap: 14px;"></div>
    <div id="loading-indicator" class="loading-indicator">読み込み中...</div>
  </div>

  <div id="post-modal" class="modal-overlay">
    <div class="modal-content">
      <h3 style="font-family:'Cinzel'; border-bottom:1px solid #333; padding-bottom:6px; color:var(--gold); margin-bottom:4px;">NEW POST</h3>
      
      <div class="form-group">
        <label class="form-label">投稿タイプ</label>
        <div class="type-select-row">
          <button type="button" class="type-btn active" id="type-photo-btn" onclick="switchPostType('photo')">1枚の写真を投稿</button>
